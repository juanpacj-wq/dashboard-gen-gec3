{
  "hooks": {
    "SessionStart": [],
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-statusline.js"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit --amend*)",
      "Bash(git commit -a*)",
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(git add -u*)",
      "Bash(git add --all*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git rebase*)",
      "Bash(git clean*)"
    ]
  }
}
